# Copy this file to .env for local runs, or set these as environment
# variables / secrets in whatever host you use.

# Required: your bot's token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=

# Optional: register slash commands to a single server while testing
# (instant updates) instead of globally (can take up to an hour).
DISCORD_GUILD_ID=

# Optional: channel ID to send ticket transcripts to instead of the
# ticket channel itself.
DISCORD_TRANSCRIPT_CHANNEL_ID=

# Optional: port for the health-check HTTP server. Most hosts set this
# automatically; only set it yourself for local runs if you want a
# specific port. Defaults to 8080.
PORT=8080
